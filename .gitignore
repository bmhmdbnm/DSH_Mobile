# Xcode and build products
ios/DSHMobile/.build/
ios/DSHMobile/DerivedData/
*.xcarchive
*.ipa

# Swift Package Manager
.build/

# Node
node_modules/
*.log

# macOS
.DS_Store

# Local credentials and machine state
ios/DSHMobile/Signing.local.plist
*.local
.env

# 本机部署地址（中转 / 更新源 / 站点）。仓库里一律是占位符，真值放这两处。
# .env.local 由 *.local 覆盖，xcconfig 需要单独一条。
.env.local
ios/DSHMobile/Config.local.xcconfig

# Python
relay/.venv/
__pycache__/
*.pyc
.pytest_cache/

# 测试产物与工具环境（本机数据，不入库）
test/runs/
test/.build/
test/.venv/

# 多 agent 开发管线的运行记录（含真实会话 id、家目录、真机证据），只在本机保留。
# 规范位置是 sidecars/agent-team/runs/（那里已有同一条规则），这里挡住的是
# 误按「仓库根 runs/<run-id>/」写下来的那一份——它不在 sidecars 的规则覆盖内。
/runs/

# AI 协作约定：写给自己用的操作手册，不随开源仓库发布
AGENTS.md

# 维护者手册（上架、促销、发放邀请码、逐步操作清单）与内部用例：
# 里面有对 agent 下的指令、以及只对部署方有意义的记录，不随开源仓库发布。
# 公开面只留面向使用者的文档（README、docs/）与可复制的用例模板（test/examples/）。
maintainers/
test/cases/

# Spec Kit（SDD 流程）的本机产物：三处都是"过程记录 + 第三方套件骨架"，不是产品。
#   .specify/    流程骨架（官方模板/脚本/宪法/本机指针），由 `specify init` 生成
#   .dsh/        10 个 /speckit-* 技能文件（DSH 发现项目技能的固定位置）
#   specs/       每个变更的 spec/plan/tasks 产物
# 结论与实现细节要发布时，落到 docs/（面向使用者）、CHANGELOG.md 或 maintainers/。
# 换机器/换人想再跑流程：`uv tool install specify-cli && specify init --here --force --integration dsh`。
.specify/
.dsh/
specs/

# 含真实设备名 / 家目录 / 会话画面的演示与证据素材。
# 这些是从真机与真实会话截的图，只在本机保留（博客渲染、本地跑测照常可用），
# 不进仓库。需要随仓库发布时，请用合成数据的截图替换后重新入库。
docs/artifacts/screenshots/
test/fixtures/media/

# 三级验证渠道（006）的运行证据：每次跑渠道都会写一份，属过程产物。
# 结构与判定见 specs/006-verify-lanes/；契约在 scripts/verify/ 与
# specs/006-verify-lanes/contracts/verdict.schema.json。
.lanes/

# 密钥与私钥文件：任何目录都不入库（含 sidecars/ 下 llm-key-router 的 keys*.txt）
# 注意：不要用 credentials* / *secret* 这类宽泛模式——
# docs/artifacts/samples/credentials_describe.json 是入库样本，会被误伤。
keys*.txt
*.key
*.pem
*.p12
id_rsa*
id_ed25519*
# 变体名（备份 / 编辑器临时文件）同样必须挡住：keys.txt.bak、backup-keys.txt、keys.txt~
# 都绕过了上面那条 `keys*.txt`。*.bak/*.orig/*.swp/*~ 是通用模式——将来真要入库一个
# .bak 样本会被静默忽略，这个方向的误伤按"宁可挡住"接受。
*keys*.txt
*keys*.txt.*
*keys*.txt~
*.bak
*.orig
*.swp
*~
