{
  "name": "dsh-plugin-doubao-image",
  "version": "0.2.0",
  "description": "Image generation through the locally installed Doubao desktop app, driven over the Chrome DevTools Protocol — no API key, no headless browser.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image",
    "doubao",
    "cdp",
    "tool"
  ],
  "license": "MIT",
  "author": "jayantTang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayantTang/DSH_Mobile.git",
    "directory": "plugins/doubao-image"
  },
  "homepage": "https://github.com/jayantTang/DSH_Mobile#readme",
  "bugs": {
    "url": "https://github.com/jayantTang/DSH_Mobile/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./doubao": "./lib/doubao.mjs",
    "./cdp": "./lib/cdp.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "generate": "node lib/generate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
